      "text": "{\n  \"teacher\": {\n    \"teacherId\": \"TCH001\",\n    \"personalInfo\": {\n      \"title\": \"Dr.\",\n      \"firstName\": \"Sarah\",\n      \"lastName\": \"Wilson\",\n      \"gender\": \"Female\"\n    },\n    \"contactInfo\": {\n      \"phoneNumber\": \"+1 (555) 123-4567\",\n      \"emailAddress\": \"sarah.wilson@school.edu\",\n      \"residentialAddress\": {\n        \"street\": \"456 Oak Avenue, Suite 12\",\n        \"city\": \"Springfield\",\n        \"state\": \"IL\",\n        \"zipCode\": \"62702\",\n        \"country\": \"United States\"\n      },\n      \"emergencyContact\": {\n        \"name\": \"Michael Wilson\",\n        \"relation\": \"Spouse\",\n        \"phone\": \"+1 (555) 987-6543\"\n      }\n    },\n    \"professionalInfo\": {\n      \"department\": \"Mathematics Department\",\n      \"qualification\": \"PhD in Mathematics\",\n      \"status\": \"Active\",\n      \"joiningDate\": \"2016-08-15\",\n      \"experience\": \"8 years, 11 months\",\n      \"assignedSubjects\": [\n        \"Mathematics\",\n        \"Advanced Calculus\",\n        \"Statistics\",\n        \"Algebra\"\n      ]\n    },\n    \"assignedClasses\": [\n      {\n        \"className\": \"10-A\",\n        \"subject\": \"Mathematics\"\n      },\n      {\n        \"className\": \"10-B\",\n        \"subject\": \"Mathematics\"\n      },\n      {\n        \"className\": \"11-A\",\n        \"subject\": \"Advanced Calculus\"\n      },\n      {\n        \"className\": \"12-A\",\n        \"subject\": \"Statistics\"\n      }\n    ],\n    \"weeklySchedule\": {\n      \"monday\": [\n        {\n          \"time\": \"9:00-10:00\",\n          \"subject\": \"Mathematics\",\n          \"class\": \"10-A\",\n          \"teacher\": \"Dr. Sarah Wilson\"\n        },\n        {\n          \"time\": \"10:00-11:00\",\n          \"subject\": \"Statistics\",\n          \"class\": \"12-A\",\n          \"teacher\": \"Dr. Sarah Wilson\"\n        },\n        {\n          \"time\": \"11:30-12:30\",\